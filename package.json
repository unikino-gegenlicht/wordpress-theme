{
  "name": "@unikino-gegenlicht/cinema-press",
  "version": "5.0.0",
  "scripts": {
    "prebuild:bulma-base": "npm run build:bulma-root",
    "build:bulma-base": "sass --load-path=node_modules --quiet-deps static/scss/custom-bulma.scss static/css/bulma.css",
    "postbuild:bulma-base": "minify static/css/bulma.css > static/css/bulma.min.css",
    "build:bulma-root": "sass --load-path=node_modules --quiet-deps static/scss/root.scss static/css/root.css",
    "postbuild:bulma-root": "minify static/css/root.css > static/css/root.min.css",
    "build:fa-base": "sass --load-path=node_modules --quiet-deps static/scss/custom-fontawesome.scss static/css/fa.css",
    "postbuild:fa-base": "minify static/css/fa.css > static/css/fa.min.css",
    "prebuild:css": "npm run build:bulma-base && npm run build:fa-base",
    "build:css": "sass --load-path=node_modules --quiet-deps style.scss style.css",
    "postbuild:css": "minify style.css > style.min.css",
    "watch:css": "sass --watch --load-path=node_modules assets/scss/style.scss style.css",
    "prei18n:update": "composer exec wp i18n make-pot ./",
    "i18n:update": "composer exec wp i18n update-po ./i18n/cinema-press-theme.pot",
    "i18n:compile": "composer exec wp i18n make-mo ./i18n/"
  },
  "author": "Unikino GEGENLICHT",
  "license": "EUPL-1.2",
  "description": "The CinemaPress theme offers small student lead cinemas a possibility to easily integrate the contents provided by the CinemaPress plugin into their website. In addition, the theme also generates <a href=\"https://schema.org\">Schema.org</a> markup in case YoastSEO is not installed on the website.",
  "maintainers": [],
  "volta": {
    "node": "26.12.0"
  },
  "devDependencies": {
    "minify": "^15.3.1",
    "sass": "^1.105.2"
  },
  "dependencies": {
    "bulma": "^1.0.4",
    "bulma-v1-tooltip": "^1.0.2"
  }
}
