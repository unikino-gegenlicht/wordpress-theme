#. Theme URI of the theme
#: style.css
msgid "https://github.com/unikino-gegenlicht/wordpress-theme"
msgstr "https://github.com/unikino-gegenlicht/custom-post-types"

#. Description of the theme
#: style.css
msgid ""
"The CinemaPress theme offers small student lead cinemas a possibility to "
"easily integrate the contents provided by the CinemaPress plugin into their "
"website. In addition, the theme also generates <a href=\"https://"
"schema.org\">Schema.org</a> markup in case YoastSEO is not installed on the "
"website."
msgstr ""

