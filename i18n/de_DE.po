#. Theme Name of the theme
#: style.css
msgid "CinemaPress"
msgstr "CinemaPress"

#. Theme URI of the theme
#: style.css
msgid "https://github.com/unikino-gegenlicht/wordpress-theme"
msgstr "https://github.com/unikino-gegenlicht/custom-post-types"

#. Description of the theme
#: style.css
msgid "The CinemaPress theme offers small student lead cinemas a possibility to easily integrate the contents provided by the CinemaPress plugin into their website. In addition, the theme also generates <a href=\"https://schema.org\">Schema.org</a> markup in case YoastSEO is not installed on the website."
msgstr "Das CinemaPress-Theme bietet kleinen, von Studenten geführten Kinos die Möglichkeit, die vom CinemaPress-Plugin bereitgestellten Inhalte problemlos in ihre Website zu integrieren. Darüber hinaus generiert das Theme auch <a href=\"https://schema.org\">Schema.org</a>-Markup, falls Yoast SEO nicht auf der Website installiert ist."

#. Author of the theme
#: style.css
msgid "Jan Eike Suchard, Philip Kaufmann"
msgstr "Jan Eike Suchard, Philip Kaufmann"

#. Author URI of the theme
